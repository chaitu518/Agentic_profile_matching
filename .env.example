# ---- Milestone 2 (unchanged) ----
EMBEDDING_PROVIDER=auto        # openai | cohere | huggingface | local | auto
# OPENAI_API_KEY=  COHERE_API_KEY=  ANTHROPIC_API_KEY=

# ---- Milestone 3 agent ----
M3_EMBEDDING_PROVIDER=local    # embedder for the agent's 100-resume index (local = deterministic, offline)
SHORTLIST_SIZE=10
# Optional LLM (leave empty for deterministic mode). openrouter reuses Milestone 1's key:
LLM_PROVIDER=                  # openrouter | openai | anthropic | groq | google | ollama
LLM_MODEL=                     # e.g. openai/gpt-4o-mini for openrouter
OPENROUTER_API_KEY=
